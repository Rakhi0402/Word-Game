APP_NAME=kungfu-word-quest-backend

# Local Postgres (docker-compose)
DATASOURCE_URL=jdbc:postgresql://localhost:5432/kungfu_word_quest
DB_USERNAME=dev_user
DB_PASSWORD=dev_password
DB_DRIVER=org.postgresql.Driver

MAX_POOL_SIZE=10
MIN_IDLE_SIZE=2
CONNECTION_TIMEOUT=30000
IDLE_TIMEOUT=600000

# Replace with a long random secret (Base64 or 32+ char string). Never commit real values.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
EXPIRATION_MS=86400000
REFRESH_EXPIRATION_MS=604800000

SCHEDULING_POOL_SIZE=2
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
BATCH_SIZE=20

REDIS_HOST=localhost
REDIS_PORT=6379
