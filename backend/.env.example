APP_NAME=kungfu-word-quest-backend
SERVER_PORT=8080
# local (default) | prod
SPRING_PROFILES_ACTIVE=local

# Local Docker Postgres (docker compose up -d)
DATASOURCE_URL=jdbc:postgresql://localhost:5432/kungfu_word_quest
DB_USERNAME=dev_user
DB_PASSWORD=dev_password
DB_DRIVER=org.postgresql.Driver

# Schema: Flyway owns migrations. Keep validate.
JPA_DDL_AUTO=validate
FLYWAY_ENABLED=true

MAX_POOL_SIZE=10
MIN_IDLE_SIZE=2
CONNECTION_TIMEOUT=30000
IDLE_TIMEOUT=600000

# Replace with a long random secret (32+ chars). Never commit real production values.
JWT_SECRET=CHANGE_ME_TO_A_LONG_RANDOM_SECRET_AT_LEAST_32_CHARS
EXPIRATION_MS=86400000
REFRESH_EXPIRATION_MS=604800000

SCHEDULING_POOL_SIZE=2
HIBERNATE_DIALECT=org.hibernate.dialect.PostgreSQLDialect
BATCH_SIZE=20

# Local Docker Redis (compose maps host 6380 → container 6379)
REDIS_HOST=localhost
REDIS_PORT=6380

# Comma-separated browser origins allowed for CORS
APP_CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# Optional admin bootstrap (preferred over local seed in shared envs)
# ADMIN_EMAIL=admin@example.com
# ADMIN_PASSWORD=change-me-strong-password
# ADMIN_USERNAME=admin

# Dev-only fallback admin@local.test — MUST be false in production
APP_SEED_LOCAL_ADMIN=true

# OpenAPI / Swagger (disabled automatically on prod profile)
SPRINGDOC_ENABLED=true

# Groq LLM (admin AI letter-hive proposals only; words validated against local dictionary)
# GROQ_ENABLED=true
# GROQ_API_KEY=
# GROQ_MODEL=openai/gpt-oss-20b
# GROQ_BASE_URL=https://api.groq.com/openai/v1
